{
  "name": "operation-shadow",
  "private": true,
  "description": "Operation Shadow: a browser-based 3D tactical stealth game.",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": "24.x"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @operation-shadow/web dev",
    "build": "pnpm --filter @operation-shadow/web build",
    "start": "pnpm --filter @operation-shadow/web start",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "pnpm -r typecheck && tsc -p tests/tsconfig.json && tsc -p tools/tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @operation-shadow/db generate",
    "db:migrate": "pnpm --filter @operation-shadow/db migrate",
    "db:seed": "pnpm --filter @operation-shadow/web seed",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "voice-bank": "tsx tools/media/voice-bank.ts",
    "textures": "tsx tools/media/textures.ts",
    "models": "tsx tools/media/models.ts",
    "hdri": "tsx tools/media/hdri.ts"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@neon/config": "^1.8.6",
    "@neon/env": "^1.5.3",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "meshoptimizer": "1.3.0",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
