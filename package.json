{
  "name": "operation-shadow",
  "private": true,
  "description": "Operation Shadow: a browser-based 3D tactical stealth game.",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": "24.x"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @operation-shadow/web dev",
    "build": "pnpm --filter @operation-shadow/web build",
    "start": "pnpm --filter @operation-shadow/web start",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "pnpm -r typecheck && tsc -p tests/tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @operation-shadow/db generate",
    "db:migrate": "pnpm --filter @operation-shadow/db migrate",
    "db:seed": "pnpm --filter @operation-shadow/web seed",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
