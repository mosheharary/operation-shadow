# Operation Shadow — environment configuration
#
# Local Docker: copy this file to `.env` (never commit it). Docker Compose reads `.env` automatically
# and already supplies working local defaults for the database, auth secret and dev login, so every
# value below is optional locally.
#
# Production (Vercel): set these in the Vercel project settings. Variables prefixed NEXT_PUBLIC_ are
# exposed to the browser; everything else is server-only and must never be given that prefix.

# ── Server-only secrets ─────────────────────────────────────────────────────────────────────────
# Google Gemini API key. Used by the build-time media tools and runtime mission generation.
GOOGLE_API_KEY=

# Mission generation. AI_PROVIDER: gemini (default when GOOGLE_API_KEY is set) | disabled (offline
# generator only, the default without a key) | mock (canned answers; local and test only).
AI_PROVIDER=
# Pinned text model for mission plans.
GEMINI_TEXT_MODEL=gemini-3.8-flash
# Draws a dossier sketch for each AI-drafted operation (about 10 s, a few cents). `none` turns it off.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Global estimated spend cap per calendar month (UTC); beyond it every job uses the offline generator.
AI_MONTHLY_BUDGET_USD=5
# Generated operations each player may request per 24 hours.
AI_DAILY_JOBS_PER_USER=20

# Session signing secret, at least 32 random characters in production (e.g. `openssl rand -base64 32`).
BETTER_AUTH_SECRET=

# Google OAuth client for sign-in. Optional locally (without it only the dev test login is shown).
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Database ───────────────────────────────────────────────────────────────────────────────────
# Runtime connection. Neon: the pooled ("-pooler") connection string with sslmode=require.
DATABASE_URL=
# Direct (unpooled) connection used by migrations. Neon: the non-pooler string. Falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=

# ── URLs ───────────────────────────────────────────────────────────────────────────────────────
BETTER_AUTH_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:4000

# ── Environment ────────────────────────────────────────────────────────────────────────────────
# One of: local | test | preview | production
APP_ENV=local

# Dev-only test-operator login (local Docker and automated tests). The server refuses to start if
# this is "true" in production. Never set it on Vercel.
ALLOW_DEV_LOGIN=false
DEV_LOGIN_PASSWORD=
